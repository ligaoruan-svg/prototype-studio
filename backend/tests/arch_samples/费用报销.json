{
 "spec": {
  "summary": "企业费用报销：员工填报、部门经理审批、财务审核、出纳付款",
  "roles": [
   {
    "name": "员工"
   },
   {
    "name": "部门经理"
   },
   {
    "name": "财务"
   },
   {
    "name": "出纳"
   }
  ],
  "objects": [
   {
    "name": "报销单",
    "owner": "员工",
    "states": [
     "草稿",
     "待审批",
     "待财务审核",
     "待付款",
     "已付款",
     "已驳回"
    ],
    "fields": "报销单号🔒、申请人🔒、所属部门🔒、报销事由*、报销金额🔒、发票附件*（上传）、收款账户*、提交时间🔒、付款时间🔒",
    "actions": [
     "新建：—→草稿（员工）",
     "提交：草稿/已驳回→待审批（员工，需填费用明细）",
     "审批通过：待审批→待财务审核（部门经理）",
     "审批驳回：待审批→已驳回（部门经理，需填驳回原因）",
     "财务通过：待财务审核→待付款（财务）",
     "财务驳回：待财务审核→已驳回（财务，需填驳回原因）",
     "付款：待付款→已付款（出纳，需填付款流水号）"
    ]
   },
   {
    "name": "费用明细",
    "owner": "员工",
    "fields": "所属报销单*（关联：报销单）、费用类型*（关联：费用类型）、发生日期*、金额*、说明"
   },
   {
    "name": "费用类型",
    "owner": "财务",
    "fields": "类型名称*、科目编码*、单笔上限、状态*（下拉：启用/停用）"
   }
  ],
  "flows": [
   "员工填报销单和费用明细 → 部门经理审批 → 财务审核 → 出纳付款"
  ],
  "rules": [
   "单笔费用超过费用类型上限的，财务审核时标红"
  ],
  "scope": {
   "in": [
    "报销填报审批付款"
   ],
   "out": [
    "预算控制"
   ],
   "external": [
    "网银"
   ]
  }
 },
 "plan": {
  "modules": [
   {
    "name": "报销",
    "pages": [
     {
      "name": "我的报销",
      "type": "list",
      "object": "报销单",
      "who": [
       "员工"
      ]
     },
     {
      "name": "待我审批",
      "type": "tasks",
      "object": "报销单",
      "who": [
       "部门经理"
      ]
     },
     {
      "name": "财务审核",
      "type": "tasks",
      "object": "报销单",
      "who": [
       "财务"
      ]
     },
     {
      "name": "待付款",
      "type": "tasks",
      "object": "报销单",
      "who": [
       "出纳"
      ]
     }
    ]
   },
   {
    "name": "设置",
    "pages": [
     {
      "name": "费用类型",
      "type": "config",
      "object": "费用类型",
      "who": [
       "财务"
      ]
     }
    ]
   },
   {
    "name": "统计",
    "pages": [
     {
      "name": "报销统计",
      "type": "report",
      "object": "报销单",
      "who": [
       "财务"
      ],
      "metrics": [
       "报销总额：已付款报销单金额合计",
       "报销笔数"
      ],
      "dims": [
       "所属部门",
       "费用类型"
      ]
     }
    ]
   }
  ]
 }
}