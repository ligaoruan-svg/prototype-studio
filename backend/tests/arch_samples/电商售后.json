{
 "spec": {
  "summary": "电商订单与售后后台：客服处理订单与售后，仓库发货和收退货，运营管理商品",
  "roles": [
   {
    "name": "客服"
   },
   {
    "name": "仓管"
   },
   {
    "name": "运营"
   },
   {
    "name": "顾客"
   }
  ],
  "objects": [
   {
    "name": "订单",
    "owner": "客服",
    "states": [
     "待付款",
     "待发货",
     "已发货",
     "已完成",
     "已取消"
    ],
    "fields": "订单号🔒、顾客昵称🔒、收货人*、收货电话*、收货地址*、订单金额🔒、物流单号、下单时间🔒、支付时间🔒",
    "actions": [
     "付款：待付款→待发货（顾客小程序）",
     "取消：待付款/待发货→已取消（客服，需填取消原因）",
     "发货：待发货→已发货（仓管，需填物流单号）",
     "确认收货：已发货→已完成（顾客小程序）",
     "改地址：待发货→待发货（客服，需填收货地址）"
    ]
   },
   {
    "name": "订单商品",
    "owner": "客服",
    "fields": "所属订单*（关联：订单）、商品*（关联：商品）、单价🔒、数量*、小计🔒"
   },
   {
    "name": "售后单",
    "owner": "客服",
    "states": [
     "待审核",
     "待退货",
     "待退款",
     "已完成",
     "已拒绝"
    ],
    "fields": "售后单号🔒、订单*（关联：订单）、售后类型*（下拉：仅退款/退货退款）、申请原因*、凭证照片（上传）、退款金额*、申请时间🔒",
    "actions": [
     "申请：—→待审核（顾客小程序）",
     "同意：待审核→待退货（客服）",
     "拒绝：待审核→已拒绝（客服，需填拒绝原因）",
     "收货入库：待退货→待退款（仓管）",
     "退款：待退款→已完成（客服，需填退款金额）"
    ]
   },
   {
    "name": "商品",
    "owner": "运营",
    "states": [
     "上架",
     "下架"
    ],
    "fields": "商品编码*、商品名称*、类目*（下拉：服饰/数码/家居）、售价*、库存*、主图（上传）",
    "actions": [
     "上架：下架→上架（运营）",
     "下架：上架→下架（运营）"
    ]
   }
  ],
  "flows": [
   "顾客下单付款 → 仓管发货 → 顾客确认收货；售后：顾客申请 → 客服审核 → 仓管收退货 → 客服退款"
  ],
  "rules": [
   "待发货超过 48 小时在订单列表标红"
  ],
  "scope": {
   "in": [
    "订单",
    "售后",
    "商品"
   ],
   "out": [
    "营销活动"
   ],
   "external": [
    "顾客小程序",
    "支付",
    "物流"
   ]
  }
 },
 "plan": {
  "modules": [
   {
    "name": "订单",
    "pages": [
     {
      "name": "订单管理",
      "type": "list",
      "object": "订单",
      "who": [
       "客服"
      ],
      "add": false
     },
     {
      "name": "待发货",
      "type": "tasks",
      "object": "订单",
      "who": [
       "仓管"
      ]
     }
    ]
   },
   {
    "name": "售后",
    "pages": [
     {
      "name": "售后处理",
      "type": "list",
      "object": "售后单",
      "who": [
       "客服"
      ],
      "add": false
     },
     {
      "name": "退货入库",
      "type": "tasks",
      "object": "售后单",
      "who": [
       "仓管"
      ]
     }
    ]
   },
   {
    "name": "商品",
    "pages": [
     {
      "name": "商品管理",
      "type": "list",
      "object": "商品",
      "who": [
       "运营"
      ]
     }
    ]
   },
   {
    "name": "数据",
    "pages": [
     {
      "name": "销售统计",
      "type": "report",
      "object": "订单",
      "who": [
       "运营"
      ],
      "metrics": [
       "销售额：已完成订单金额合计",
       "订单数",
       "售后率：售后单数 / 订单数"
      ],
      "dims": [
       "类目"
      ]
     }
    ]
   }
  ]
 }
}