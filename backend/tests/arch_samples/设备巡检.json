{
 "spec": {
  "summary": "工厂设备巡检：主管排巡检任务，巡检员按点检查，发现故障转维修，主管验收",
  "roles": [
   {
    "name": "设备主管"
   },
   {
    "name": "巡检员"
   },
   {
    "name": "维修员"
   }
  ],
  "objects": [
   {
    "name": "设备",
    "owner": "设备主管",
    "states": [
     "正常",
     "故障",
     "维修中",
     "报废"
    ],
    "fields": "设备编号*、设备名称*、型号、所在车间*（下拉：一车间/二车间/三车间）、责任人（关联：巡检员）、投用日期",
    "actions": [
     "报废：正常/故障→报废（设备主管，需填报废原因）"
    ]
   },
   {
    "name": "巡检员",
    "owner": "设备主管",
    "fields": "工号*、姓名*、手机号*、所属车间*（下拉：一车间/二车间/三车间）"
   },
   {
    "name": "巡检任务",
    "owner": "设备主管",
    "states": [
     "待执行",
     "执行中",
     "已完成",
     "已逾期"
    ],
    "fields": "任务编号🔒、设备*（关联：设备）、巡检员*（关联：巡检员）、计划日期*、完成时间🔒、巡检结论（下拉：正常/异常）",
    "actions": [
     "派发：—→待执行（设备主管）",
     "开始：待执行→执行中（巡检员）",
     "提交结果：执行中→已完成（巡检员，需填巡检结论和检查项结果）",
     "逾期：待执行→已逾期（系统超时自动）"
    ]
   },
   {
    "name": "检查项结果",
    "owner": "巡检员",
    "fields": "所属任务*（关联：巡检任务）、检查项*、结果*（单选：正常/异常）、照片（上传）、说明"
   },
   {
    "name": "故障单",
    "owner": "设备主管",
    "states": [
     "待处理",
     "维修中",
     "待验收",
     "已关闭"
    ],
    "fields": "故障单号🔒、设备*（关联：设备）、故障描述*、故障照片（上传）、维修员（关联：维修员）、维修说明、上报时间🔒",
    "actions": [
     "上报：—→待处理（巡检员）",
     "指派：待处理→维修中（设备主管，必须选维修员）",
     "维修完成：维修中→待验收（维修员，需填维修说明）",
     "验收通过：待验收→已关闭（设备主管）",
     "验收不通过：待验收→维修中（设备主管，需填不通过原因）"
    ]
   },
   {
    "name": "维修员",
    "owner": "设备主管",
    "fields": "工号*、姓名*、手机号*、擅长类别"
   }
  ],
  "flows": [
   "主管派发巡检任务 → 巡检员执行并提交结果 → 有异常上报故障单 → 主管指派维修员 → 维修完成 → 主管验收"
  ],
  "rules": [
   "巡检任务超过计划日期未完成自动转已逾期并标红"
  ],
  "scope": {
   "in": [
    "设备台账",
    "巡检",
    "故障维修"
   ],
   "out": [
    "备件库存"
   ],
   "external": []
  }
 },
 "plan": {
  "modules": [
   {
    "name": "首页",
    "pages": [
     {
      "name": "首页",
      "type": "dashboard",
      "object": "巡检任务",
      "who": [
       "设备主管"
      ],
      "metrics": [
       "今日待巡检",
       "逾期任务数",
       "待验收故障单"
      ],
      "lists": [
       "逾期巡检任务"
      ]
     }
    ]
   },
   {
    "name": "巡检",
    "pages": [
     {
      "name": "巡检任务",
      "type": "list",
      "object": "巡检任务",
      "who": [
       "设备主管"
      ]
     },
     {
      "name": "我的巡检",
      "type": "tasks",
      "object": "巡检任务",
      "who": [
       "巡检员"
      ]
     }
    ]
   },
   {
    "name": "维修",
    "pages": [
     {
      "name": "故障单",
      "type": "list",
      "object": "故障单",
      "who": [
       "设备主管",
       "巡检员"
      ]
     },
     {
      "name": "我的维修",
      "type": "tasks",
      "object": "故障单",
      "who": [
       "维修员"
      ]
     }
    ]
   },
   {
    "name": "台账",
    "pages": [
     {
      "name": "设备台账",
      "type": "list",
      "object": "设备",
      "who": [
       "设备主管"
      ]
     },
     {
      "name": "巡检员",
      "type": "config",
      "object": "巡检员",
      "who": [
       "设备主管"
      ]
     },
     {
      "name": "维修员",
      "type": "config",
      "object": "维修员",
      "who": [
       "设备主管"
      ]
     }
    ]
   }
  ]
 }
}